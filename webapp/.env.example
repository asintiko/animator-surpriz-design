SURPRIZ_BACKEND_ORIGIN=http://127.0.0.1:5052
SURPRIZ_ADAPTER_ORIGIN=http://127.0.0.1:5051
SURPRIZ_ADAPTER_TOKEN=replace-with-a-random-internal-token
SURPRIZ_CANONICAL_URL=https://eventsurpriz.uz
# Keep adapter metadata and generated media outside an immutable release directory.
SURPRIZ_ADAPTER_DATA_DIR=/var/lib/surpriz/adapter
SURPRIZ_CANONICAL_DATABASE=/var/lib/surpriz/site_admin.sqlite3
SURPRIZ_MEDIA_PRIVATE_ROOT=/var/lib/surpriz/media
SURPRIZ_MEDIA_PUBLIC_ROOT=/var/www/surpriz-media
