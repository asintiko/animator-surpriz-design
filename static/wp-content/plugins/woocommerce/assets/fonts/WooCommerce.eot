<script>
(function () {
    var ROOT_SELECTOR = '.js-tariff-collapse'; // контейнер тарифа
    var HIDE_SELECTOR = '.hide-content';       // блоки-якоря

    document.addEventListener('DOMContentLoaded', function () {
        // если нужно работать только на мобилке — оставляем:
        if (!window.matchMedia('(max-width: 767px)').matches) return;
        // если нужно везде — просто убери строку выше

        var cards = document.querySelectorAll(ROOT_SELECTOR);
        cards.forEach(function (card) {
            var hideItems = card.querySelectorAll(HIDE_SELECTOR);
            if (hideItems.length < 2) return; // нужен первый и последний

            var first = hideItems[0];
            var last  = hideItems[hideItems.length - 1];

            if (first.parentNode !== last.parentNode) return;

            var parent = first.parentNode;

            // создаём обёртку для скрываемой части
            var wrapper = document.createElement('div');
            wrapper.className = 'tariff-more-content is-collapsed';
            parent.insertBefore(wrapper, first);

            // переносим всё от first до last включительно внутрь wrapper
            var node = first;
            while (node) {
                var next = node.nextSibling;
                wrapper.appendChild(node);
                if (node === last) break;
                node = next;
            }

            // создаём кнопку сразу после wrapper
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'tariff-more-toggle';
            btn.textContent = 'Подробнее';

            if (wrapper.nextSibling) {
                parent.insertBefore(btn, wrapper.nextSibling);
            } else {
                parent.appendChild(btn);
            }

            // обработчик клика
            btn.addEventListener('click', function () {
                var collapsed = wrapper.classList.toggle('is-collapsed');
                btn.textContent = collapsed ? 'Подробнее' : 'Свернуть';
            });
        });
    });
})();
	
	
	document.addEventListener('DOMContentLoaded', function () {
  var links = document.querySelectorAll('.js-tabs-scroll .elementor-widget-button a');

  links.forEach(function (link) {
    link.setAttribute('href', 'tg://resolve?phone=998998926565');
    // если нужно открывать в новом окне — раскомментируй строку ниже
    // link.setAttribute('target', '_blank');
  });
});

</script>


<script>
(function () {
    document.addEventListener('DOMContentLoaded', function () {
        var widgets = document.querySelectorAll('.js-tabs-scroll');

        widgets.forEach(function (widget) {
            var tabsRoot = widget.querySelector('.e-n-tabs');
            if (!tabsRoot) return;

            var heading = tabsRoot.querySelector('.e-n-tabs-heading');
            if (!heading) return;

            // чтобы не инициализировать дважды
            if (heading.dataset.tabsScrollInit === '1') return;
            heading.dataset.tabsScrollInit = '1';

            // стрелки: если вдруг уже есть — используем их, если нет — создаём
            var btnLeft = tabsRoot.querySelector('.tabs-scroll-arrow--left');
            if (!btnLeft) {
                btnLeft = document.createElement('button');
                btnLeft.type = 'button';
                btnLeft.className = 'tabs-scroll-arrow tabs-scroll-arrow--left';
                btnLeft.innerHTML = '<i class="fas fa-angle-left" aria-hidden="true"></i>';
                heading.insertAdjacentElement('beforebegin', btnLeft);
            }

            var btnRight = tabsRoot.querySelector('.tabs-scroll-arrow--right');
            if (!btnRight) {
                btnRight = document.createElement('button');
                btnRight.type = 'button';
                btnRight.className = 'tabs-scroll-arrow tabs-scroll-arrow--right';
                btnRight.innerHTML = '<i class="fas fa-angle-right" aria-hidden="true"></i>';
                heading.insertAdjacentElement('afterend', btnRight);
            }

            function updatePageX() {
                heading.dataset.pageX = String(heading.scrollLeft || 0);
            }

            function updateArrows() {
                var maxScrollLeft = heading.scrollWidth - heading.clientWidth;

                // Всё помещается — стрелки не нужны
                if (maxScrollLeft <= 1) {
                    btnLeft.style.display = 'none';
                    btnRight.style.display = 'none';
                    return;
                }

                // В начале списка — прячем левую
                if (heading.scrollLeft <= 1) {
                    btnLeft.style.display = 'none';
                } else {
                    btnLeft.style.display = '';
                }

                // В конце списка — прячем правую
                if (heading.scrollLeft >= maxScrollLeft - 1) {
                    btnRight.style.display = 'none';
                } else {
                    btnRight.style.display = '';
                }
            }

            // Скролл на ширину следующего/предыдущего таба
            function scrollToTab(direction) {
                var tabs = Array.prototype.slice.call(
                    heading.querySelectorAll('.e-n-tab-title')
                );
                if (!tabs.length) return;

                var containerRect = heading.getBoundingClientRect();
                var target = null;

                if (direction > 0) {
                    // вправо: ищем первый таб, который не левее контейнера,
                    // и берём следующий (или его самого, если он последний)
                    for (var i = 0; i < tabs.length; i++) {
                        var r = tabs[i].getBoundingClientRect();
                        if (r.left >= containerRect.left - 1) {
                            var nextIndex = Math.min(i + 1, tabs.length - 1);
                            target = tabs[nextIndex];
                            break;
                        }
                    }
                    // если не нашли — подстрахуемся последним табом
                    if (!target) target = tabs[tabs.length - 1];
                } else {
                    // влево: ищем первый таб, который виден слева,
                    // и берём предыдущий (или его самого, если он первый)
                    for (var j = 0; j < tabs.length; j++) {
                        var r2 = tabs[j].getBoundingClientRect();
                        if (r2.left >= containerRect.left - 1) {
                            var prevIndex = Math.max(j - 1, 0);
                            target = tabs[prevIndex];
                            break;
                        }
                    }
                    if (!target) target = tabs[0];
                }

                if (!target) return;

                var targetRect = target.getBoundingClientRect();
                var delta = targetRect.left - containerRect.left;

                if (Math.abs(delta) < 1) return; // почти на месте, не дёргаем

                heading.scrollBy({
                    left: delta,
                    behavior: 'smooth'
                });

                setTimeout(function () {
                    updatePageX();
                    updateArrows();
                }, 250);
            }

            // Клики по стрелкам
            btnLeft.addEventListener('click', function () {
                scrollToTab(-1);
            });

            btnRight.addEventListener('click', function () {
                scrollToTab(1);
            });

            // Любой горизонтальный скролл (свайп и т.п.)
            heading.addEventListener('scroll', function () {
                updatePageX();
                updateArrows();
            });

            // На старте выставляем корректное состояние стрелок
            updatePageX();
            updateArrows();
        });
    });
})();
</script>


