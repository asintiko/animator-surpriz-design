	<meta name="generator" content="Elementor 3.32.4; features: additional_custom_breakpoints; settings: css_print_method-internal, google_font-enabled, font_display-auto">
<style>
  .snow-container {
    position: fixed;
    top: 0;
    left: 0;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    pointer-events: none; /* чтобы снег не мешал кликам по сайту */
  }

  .snowflake {
    position: absolute;
    background-color: #ffffff;
    border-radius: 50%;
    opacity: 0.8;
    pointer-events: none;
  }

  @keyframes fall {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    10% {
      opacity: 1;
    }
    100% {
      opacity: 0.5;
      transform: translateY(100vh);
    }
  }

  @keyframes diagonal-fall {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    10% {
      opacity: 1;
    }
    100% {
      opacity: 0.25;
      transform: translate(10vw, 100vh);
    }
  }
</style>

<script>
  (function () {
    document.addEventListener("DOMContentLoaded", function () {
      // создаём контейнер для снега
      var existing = document.querySelector(".snow-container");
      var snowContainer = existing || document.createElement("div");
      if (!existing) {
        snowContainer.className = "snow-container";
        document.body.appendChild(snowContainer);
      }

      var particlesPerThousandPixels = 0.1; // плотность снега
      var fallSpeed = 1.25;                 // скорость падения (выше = быстрее)
      var pauseWhenNotActive = true;        // пауза, когда вкладка неактивна
      var maxSnowflakes = 200;              // максимум снежинок
      var snowflakes = [];

      var snowflakeInterval;
      var isTabActive = true;

      function resetSnowflake(snowflake) {
        var size = Math.random() * 5 + 1;
        var viewportWidth = window.innerWidth - size;
        var viewportHeight = window.innerHeight;

        snowflake.style.width = size + "px";
        snowflake.style.height = size + "px";
        snowflake.style.left = Math.random() * viewportWidth + "px";
        snowflake.style.top = -size + "px";

        var animationDuration = (Math.random() * 3 + 2) / fallSpeed;
        snowflake.style.animationDuration = animationDuration + "s";
        snowflake.style.animationTimingFunction = "linear";
        snowflake.style.animationName =
          Math.random() < 0.5 ? "fall" : "diagonal-fall";

        setTimeout(function () {
          var top = parseFloat(snowflake.style.top || "0");
          if (top < viewportHeight) {
            resetSnowflake(snowflake);
          } else {
            // убираем снежинку когда улетела вниз
            var index = snowflakes.indexOf(snowflake);
            if (index !== -1) snowflakes.splice(index, 1);
            if (snowflake.parentNode) {
              snowflake.parentNode.removeChild(snowflake);
            }
          }
        }, animationDuration * 1000);
      }

      function createSnowflake() {
        if (snowflakes.length >= maxSnowflakes) return;

        var snowflake = document.createElement("div");
        snowflake.className = "snowflake";
        snowflakes.push(snowflake);
        snowContainer.appendChild(snowflake);
        resetSnowflake(snowflake);
      }

      function generateSnowflakes() {
        var numberOfParticles =
          Math.ceil((window.innerWidth * window.innerHeight) / 1000) *
          particlesPerThousandPixels;

        var interval = 5000 / numberOfParticles;
        clearInterval(snowflakeInterval);

        snowflakeInterval = setInterval(function () {
          if (isTabActive && snowflakes.length < maxSnowflakes) {
            requestAnimationFrame(createSnowflake);
          }
        }, interval);
      }

      function handleVisibilityChange() {
        if (!pauseWhenNotActive) return;
        isTabActive = !document.hidden;

        if (isTabActive) {
          generateSnowflakes();
        } else {
          clearInterval(snowflakeInterval);
        }
      }

      generateSnowflakes();

      window.addEventListener("resize", function () {
        clearInterval(snowflakeInterval);
        setTimeout(generateSnowflakes, 1000);
      });

      document.addEventListener("visibilitychange", handleVisibilityChange);
    });
  })();
</script>

