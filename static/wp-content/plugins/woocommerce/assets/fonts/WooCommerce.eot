		<style id="wp-custom-css">
			html,body{
width:100%;
	overflow-x:hidden !important;
}

.woocommerce ul.products li.product.desktop-align-center, .woocommerce-page ul.products li.product.desktop-align-center{
overflow:visible;
}


.elementor .elementor-element.elementor-widget-n-tabs:not(:has(>.elementor-widget-container))>.e-n-tabs>.e-n-tabs-heading .e-n-tab-title[aria-selected=true]{
background-color:#FF780B;
}

/* сколько видно в свернутом состоянии (можно 0, если хочешь скрыть полностью) */
.tariff-more-content {
    overflow: hidden;
    max-height: 2000px;           /* высота в раскрытом состоянии */
    transition: max-height 0.3s ease; /* плавное раскрытие/схлопывание */
}

.tariff-more-content.is-collapsed {
    max-height: 0px; /* то, что видно до клика; подгони под себя */
}

/* кнопка, только базовое, чтобы было к чему цепляться */
.tariff-more-toggle {
    margin-top: 10px;
    cursor: pointer;
	z-index:2;
    /* остальное оформление — как захочешь */
}


/* кнопка, всё остальное (цвета, бордеры) задашь сам */
.tariff-more-toggle {
    position: relative;
    cursor: pointer;
    padding-right: 32px; /* место под иконку справа */
}

/* иконка по умолчанию — angle-down */
.tariff-more-content + .tariff-more-toggle::after {
    font-family: "Font Awesome 5 Free", "FontAwesome";
    font-weight: 900;          /* solid-иконки */
    content: "\f107";          /* fa-angle-down */
    font-size: 0.9em;

    position: absolute;
    right: 20px;               /* отступ от правого края кнопки */
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;      /* чтобы клик ловила сама кнопка */
}

/* когда блок раскрыт — angle-up */
.tariff-more-content:not(.is-collapsed) + .tariff-more-toggle::after {
    content: "\f106";          /* fa-angle-up */
}

.e-n-tabs .elementor-price-list .elementor-price-list-item .elementor-price-list-title{
max-width:70% !important;
}

.e-n-tabs .elementor-price-list .elementor-price-list-item .elementor-price-list-price{
text-align:right;
}


.e-n-tabs .swiper-pagination-bullets{
position:absolute;
	top:-17px !important;
	transform:translateX(-50%) !important;
	left:50% !important;
}

/* контейнер с табами — делаем его опорой для позиционирования стрелок */
.js-tabs-scroll {
    position: relative;
}

/* Elementor сам вешает overflow-x:auto на .e-n-tabs-heading при Horizontal Scroll,
   мы это не трогаем, только добавим плавность */
.js-tabs-scroll .e-n-tabs-heading {
    scroll-behavior: smooth;
}

/* Стрелки как overlay поверх краёв табов */
.js-tabs-scroll .tabs-scroll-arrow {
    position: absolute;
	font-size:15px;
    top: 0px;
    z-index: 5;
    border: none;
    background: #7123e48f; /* подгони под фон */
    padding: 10px 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
	color:#fff
}

@media(min-width:768px){
	
	
	.js-tabs-scroll .tabs-scroll-arrow{
top:8px;
}
	.js-tabs-scroll .tabs-scroll-arrow--left{
left: -20px;
}
	
	.js-tabs-scroll .tabs-scroll-arrow--right {
    right: -20px;
}
	
	
}

@media(max-width:767px){
	.woocommerce div.product .related.products ul.products li.product, .woocommerce[class*="rel-up-columns-"] div.product .related.products ul.products li.product, .woocommerce-page div.product .related.products ul.products li.product, .woocommerce-page[class*="rel-up-columns-"] div.product .related.products ul.products li.product{
margin-right:0px;
}
	
.ast-container, .ast-container-fluid {
    margin-left: auto;
    margin-right: auto;
    padding-left: 10px;
    padding-right: 10px;
}
}

/* левая/правая позиции — подгони отступы под свой дизайн */
.js-tabs-scroll .tabs-scroll-arrow--left {
    left: -8px;
}
.js-tabs-scroll .tabs-scroll-arrow--right {
    right: -8px;
}

/* когда дальше скроллить нельзя — прячем/глушим стрелки */
.js-tabs-scroll .tabs-scroll-arrow[disabled] {
    opacity: 0;
    pointer-events: none;
}

/* чтобы стрелки не мешали свайпу по центру, при желании можно сузить кликабельные области
   (например, уменьшить padding или задать конкретную ширину/высоту) */



header#c-header.elementor-sticky--effects{
box-shadow: 0px 10px 20px 0px rgba(0, 0, 0, 0.1);
}


/* =========================================
   6) Декор секции блога (боковые картинки)
========================================= */
.c-sales:before,
.c-sales:after{
  content: "";
  position: absolute;
  display: block;
  top: 0;
  bottom: 0;
  background-repeat: no-repeat;
  background-size: contain;
  background-position: 0 50%;
  width: 155px;
  z-index: -1;
}
.c-sales:before{
  left: 0;
  background-image: url('/wp-content/uploads/2025/10/cake-left.png');
}
.c-sales:after{
  right: 0;
  background-image: url('/wp-content/uploads/2025/10/cake-right.png');
}




body.post-type-archive-product{
	
background-image:url('/wp-content/uploads/2025/10/vecteezy_vector-blue-confetti-background_26587577.svg');
	background-repeat:no-repeat;
background-size:cover;
background-position:top center;
	background-color:#FDFDFD;
	background-attachment:fixed;
}


.main-catalog:before,
.main-catalog:after{
  content: "";
  position: absolute;
  display: block;
  top: 0;
  bottom: 0;
  background-repeat: no-repeat;
  background-size: contain;
  width: 155px;
  z-index: -1;
}
.main-catalog:before{
  left: 0;
  background-image: url('/wp-content/uploads/2025/11/balloons-l.png');
	  background-position: 0 50%;
}

.main-catalog:after{
  right: 0;
  background-image: url('/wp-content/uploads/2025/11/balloons-r.png');
	  background-position: 0 2%;
}



