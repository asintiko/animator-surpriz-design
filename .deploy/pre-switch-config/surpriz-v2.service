[Unit]
Description=Surpriz production web 20260807T142712Z
After=network.target

[Service]
Type=simple
User=surpriz
Group=surpriz
UMask=0077
WorkingDirectory=/opt/surpriz-releases/20260807T142712Z
EnvironmentFile=/opt/surpriz-releases/20260807T142712Z/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/surpriz/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5052 --timeout 60 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile - app:app
