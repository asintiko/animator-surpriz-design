SURPRIZ_ENV=production
SURPRIZ_ADMIN_SECRET=
SURPRIZ_LANDING_ROOT=/opt/surpriz-current/surpriz
SURPRIZ_PUBLIC_HTTPS=1
CUSTOMER_AUTH_DEV_BYPASS=0
SURPRIZ_TELEGRAM_POLLING=0
TELEGRAM_POLLING_MODE=external
TELEGRAM_WEBHOOK_SECRET=
ADMIN_PORTAL_BASE=https://animator-surpriz.uz

YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=
TELEGRAM_GATEWAY_TOKEN=

# Google Calendar sync (optional; can also be set in /admin/calendar)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_WORKER=0
